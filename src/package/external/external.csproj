<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TestPlatformRoot Condition="$(TestPlatformRoot) == ''">../../../</TestPlatformRoot>
    <!-- TODO: Remove this before comitting, it ignores nuget signing issues. -->
    <!--
      NU1603 is added for ONE reason, and only the Fakes reference below justifies it.

      Microsoft.QualityTools.Testing.Fakes.TestRunnerHarness 17.0.0-beta.21179.1 is obtainable from
      no feed, so restore substitutes 17.4.0-beta.22405.1 and raises NU1603. -warnaserror then made
      that fatal on the very first action of the Package step.

      The pin MUST NOT be bumped to the substitute. The seven payload files it carries are copied
      into Microsoft.TestPlatform through $FakesPackageDir$ in the nuspec, so the version is SHIPPED
      CONTENT, and changing it would break equivalence with the previously published 17.3.3.

      Suppressing the warning is safe here precisely because the build never consumes the substitute:
      scripts\build.ps1 builds the payload path from the PINNED $(MicrosoftFakesVersion), so the
      substituted package sits in a directory nothing reads. The real check is not lost, only moved -
      packing still fails loudly and names the missing path if the payload was not recovered first.
      See the long comment on Restore-FakesPayload in 16.11's scripts\build.ps1 for the recovery,
      which reads the files out of the PREVIOUSLY SHIPPED package for this line.

      This does NOT silence NU1603 for Microsoft.DotNet.Build.Tasks.Feed - that pin was corrected in
      eng\Versions.props instead, because its version is used to build a UsingTask path.
    -->
    <NoWarn>$(NoWarn);NU3018;NU3027;NU1603</NoWarn>
  </PropertyGroup>
  <Import Project="$(TestPlatformRoot)scripts/build/TestPlatform.Settings.targets" />
  <PropertyGroup>
    <TargetFrameworks>net472</TargetFrameworks>
    <AssemblyName>restore</AssemblyName>
    <RuntimeIdentifier>win7-x64</RuntimeIdentifier>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateNeutralResourcesLanguageAttribute>false</GenerateNeutralResourcesLanguageAttribute>

    <!-- This proj file shouldn't create outputs during build or publish -->
    <CopyBuildOutputToOutputDirectory>false</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <CopyBuildOutputToPublishDirectory>false</CopyBuildOutputToPublishDirectory>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup Condition=" '$(DotNetBuildFromSource)' != 'true' ">
    <!-- This csproj restore external tools required for build process -->
    <PackageReference Include="NuGet.CommandLine" Version="6.0.0" PrivateAssets="All" />
    <PackageReference Include="fmdev.xlftool" Version="0.1.3" PrivateAssets="All" />
    <PackageReference Include="MicroBuild.Core" Version="0.3.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.VisualStudio.Sdk.BuildTasks.14.0" Version="14.0.12-pre" PrivateAssets="All" />
    <PackageReference Include="vswhere" Version="2.0.2" PrivateAssets="All" />
	  <PackageReference Include="Microsoft.DiaSymReader.Pdb2Pdb" Version="1.1.0-beta2-21075-01" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Internal.TestPlatform.Remote" Version="$(TestPlatformRemoteExternalsVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Internal.TestPlatform.Extensions" Version="$(TestPlatformExternalsVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeCoverage.IO" Version="$(MicrosoftInternalCodeCoverageVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.VisualStudio.TraceDataCollector" Version="$(MicrosoftInternalCodeCoverageVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Internal.CodeCoverage" Version="$(MicrosoftInternalCodeCoverageVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.VisualStudio.QualityTools" Version="$(TestPlatformExternalsVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.VisualStudio.QualityTools.DataCollectors" Version="$(TestPlatformExternalsVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.VisualStudio.CUIT" Version="$(TestPlatformExternalsVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Internal.Intellitrace" Version="$(TestPlatformExternalsVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Internal.Dia" Version="$(TestPlatformMSDiaVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Internal.Dia.Interop" Version="$(TestPlatformMSDiaVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="$(VSSdkBuildToolsVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.VisualStudio.Interop" Version="$(InteropExternalsVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.VisualStudio.Telemetry" Version="16.3.58" PrivateAssets="All" />
    <PackageReference Include="Microsoft.VisualStudio.RemoteControl" Version="16.3.23" PrivateAssets="All" />
    <PackageReference Include="Microsoft.VisualStudio.Utilities.Internal" Version="16.3.23" PrivateAssets="All" />
    <PackageReference Include="Microsoft.QualityTools.Testing.Fakes.TestRunnerHarness" Version="$(MicrosoftFakesVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Internal.Intellitrace.Extensions" Version="$(TestPlatformExternalsVersion)" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETCore.ILAsm" Version="$(ILAsmPackageVersion)" />
    <PackageReference Include="Microsoft.NETCore.ILDAsm" Version="$(ILAsmPackageVersion)" />
    <PackageReference Include="Microsoft.DotNet.Build.Tasks.Feed" Version="$(MicrosoftDotNetBuildTasksFeedVersion)" PrivateAssets="All" />

    <!--
      The seven Fakes payload files that Microsoft.TestPlatform.nuspec copies through
      $FakesPackageDir$ come from HERE, not from the PackageReference above.

      Microsoft.QualityTools.Testing.Fakes.TestRunnerHarness 17.0.0-beta.21179.1 is obtainable from
      no feed, so restore substitutes 17.4.0-beta.22405.1, which lands in a directory named after
      ITS version. The path scripts\build.ps1 builds from the PINNED version is therefore empty.
      Restore succeeds; packing fails much later, naming a path. Build 3067050 measured exactly that.

      The seven files ship INSIDE Microsoft.TestPlatform 17.3.0, so they are recovered from there by
      Restore-FakesPayload in scripts\common.lib.ps1. Downloading is consuming, not publishing.

      THE VERSION IS A LITERAL AND MUST STAY ONE. Not $(TPB_Version), not a range, not a floating
      17.3.*. If this ever resolved to "the latest 17.3.x", servicing build N+1 would take its
      payload from build N, every future build would inherit its predecessor's OUTPUT as its INPUT,
      and the drift would compound with no point at which it becomes visible. Pinned to the original
      17.3.0 release the chain always terminates there, so this recovers the original inputs rather
      than rebuilding from our own output.

      PackageDownload rather than PackageReference: nothing here is compiled against, only extracted,
      so this must not become a dependency of the assembly.
    -->
    <PackageDownload Include="Microsoft.TestPlatform" Version="[17.3.0]" />
  </ItemGroup>
  <Import Project="$(TestPlatformRoot)scripts\build\TestPlatform.targets" />

  <!-- Prevent Csc from being called -->
  <Target Name="CoreCompile" />
</Project>
