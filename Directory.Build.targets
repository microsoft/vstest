<?xml version="1.0" encoding="utf-8"?>
<Project>

  <Import Project="Sdk.targets" Sdk="Microsoft.DotNet.Arcade.Sdk" />

  <!-- A current SDK materializes InternalsVisibleTo items into the generated AssemblyInfo without a
       public key, and SignAssembly=true then makes the compiler reject them (CS1726). Supply the
       key here. This must be in .targets, not .props: props is evaluated before the projects
       declare their items, so an Update= there matches nothing and silently does nothing. -->
  <!-- No InternalsVisibleTo item fix-up here. 16.11 declares InternalsVisibleTo in 67 source files
       with the public key written out in full; there are zero InternalsVisibleTo MSBuild items in
       the repo, so an Update= would be a silent no-op. The 15.9 line needs that fix-up; this one
       does not. -->

  <!-- Arcade injects test packages into every test project: Microsoft.NET.Test.Sdk from
       Tests.props:36, and Microsoft.TestPlatform + MSTest.TestFramework + MSTest.TestAdapter from
       MSTest/MSTest.targets:14-17. All are marked IsImplicitlyDefined="true".

       Do NOT try to remove them by item surgery. PackageReference Remove matches on identity, and a
       metadata transform such as
         Remove="@(PackageReference->WithMetadataValue('IsImplicitlyDefined','true'))"
       still yields identity strings, so it takes the explicit pin along with the implicit one. That
       breaks this repo's own test projects, which pin MSTest 2.1.0 in
       scripts\build\TestPlatform.Settings.targets:88, and it silently strips the deliberate old-version
       pins in test\TestAssets that those assets exist to exercise.

       Arcade's defaults are all declared Condition="'$(X)' == ''" in DefaultVersions.props, so the
       supported fix is to set them to the versions this line already pins. Implicit and explicit then
       agree, ordinary NuGet dedupe applies, and nothing has to be removed. This also fixes NU1202:
       Arcade's defaults (MSTest 4.2.3, Microsoft.NET.Test.Sdk 18.0.1) dropped net451 support, which
       every net4x test asset on this line targets. -->
  <PropertyGroup>
    <MSTestTestFrameworkVersion>2.1.0</MSTestTestFrameworkVersion>
    <MSTestTestAdapterVersion>2.1.0</MSTestTestAdapterVersion>
    <MSTestVersion>2.1.0</MSTestVersion>
    <!-- 16.11.0 rather than this line's own 16.11.0-dev: the implicit reference has to restore from a
         feed, and 16.11.0-dev only exists once this repo has packed it. 16.11.0 is the public release
         of this same line and still supports net451. -->
    <MicrosoftNETTestSdkVersion>16.11.0</MicrosoftNETTestSdkVersion>
    <MicrosoftTestPlatformVersion>16.11.0</MicrosoftTestPlatformVersion>
    <!-- Microsoft.NET.Test.Sdk generates an AutoGeneratedProgram entry point for test projects. This
         repo's test projects ship their own Program.cs, so generation gives CS0017 "more than one
         entry point". Pre-Arcade this line referenced no Microsoft.NET.Test.Sdk at all and nothing
         was generated, so turning generation off restores the original behaviour rather than
         inventing new behaviour. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <!-- The netcoreapp2.1 leg of every test project was compiling against the SHIPPED 16.11.0
       assemblies instead of the code being built.

       Microsoft.NET.Test.Sdk, pinned to 16.11.0 just above, depends on
       Microsoft.TestPlatform.TestHost 16.11.0, and that package carries full copies of seven
       product assemblies under lib/netcoreapp2.1/ - CommunicationUtilities, CoreUtilities,
       CrossPlatEngine, PlatformAbstractions, Utilities, Common and ObjectModel. They are real
       compile assets, not placeholders. This line's product projects build netstandard2.0, so for
       a netcoreapp2.1 consumer the package asset is the closer framework match and conflict
       resolution keeps it and drops the project output. The net451 leg is unaffected because the
       local build produces net451 exactly, which no package asset can beat.

       The failure mode is silent. The tests still compile and still pass; they simply exercise
       released binaries on that leg, so no product change is visible to them. Measured directly on
       the merged delivery head with no other change in the tree:

         netcoreapp2.1  ...\.nuget\packages\microsoft.testplatform.testhost\16.11.0\lib\netcoreapp2.1\
         net451         artifacts\bin\Microsoft.TestPlatform.CommunicationUtilities\Release\net451\

       Excluding the compile assets removes the package from the compile closure and lets the
       existing project references resolve. Runtime assets are deliberately kept, so selfhost still
       gets the package's testhost payload and the run behaviour does not change.

       Include= rather than Update=: the package is a transitive dependency of Test.Sdk and is not
       an item in this repo, so Update= would match nothing - the same silent no-op recorded at the
       top of this file. Scoped to test projects so product projects do not gain a reference they
       never had. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.TestPlatform.TestHost"
                      Version="$(MicrosoftNETTestSdkVersion)"
                      ExcludeAssets="compile"
                      IsImplicitlyDefined="true" />
  </ItemGroup>

  <!-- Restore the pre-Arcade output layout: src\<Project>\bin\<Config>\<TFM>\.

       Arcade redirects output to artifacts\bin\<Project>\<Config>\<TFM>. Fifteen call sites in
       scripts\build.ps1 read the original location directly - build.ps1:408 is the first to fail,
       looking for src\testhost\bin\Release\net452\win7-x64\testhost.net452.exe - and the nuspec
       <file src=".."> entries are written against the same layout.

       Overriding OutDir here fixes all fifteen at once without editing a rel-era script, and it
       keeps the packaged layout byte-identical to the shipped 16.11 artifact, which is what the
       alignment measurement compares against.

       Note main is NOT the guide for this one: main deleted scripts\build.ps1 and has no
       src\package\nuspec at all, packing from .csproj through Arcade instead. Adopting that would
       change what the packages contain, which is a fact about this line rather than a mechanism. -->
  <!-- REVERTED: the OutDir override that used to live here.

       It set output back to the pre-Arcade src\<Project>\bin\<Config>\<TFM> layout so that the
       fifteen call sites in scripts\build.ps1 and the nuspec <file src=..> entries would resolve.
       That worked on an incremental tree and BREAKS A CLEAN BUILD, including CI's own invocation:

         CSC error CS0006: Metadata file 'artifacts\bin\...\Microsoft.TestPlatform.PlatformAbstractions.dll'
                           could not be found            [CoreUtilities, P2P reference]
         MSB4018 GenerateDepsFile: Could not find a part of the path
                           'artifacts\bin\Microsoft.TestPlatform.Build\...\.deps.json'

       Arcade and the SDK compute project-to-project reference paths and deps.json locations from
       their own layout, so relocating output desynchronises the producer from every consumer. It
       only appeared to work because stale artifacts\bin content from earlier builds satisfied the
       lookups - an incremental build is not evidence about a clean one.

       Packaging therefore needs a different approach: stage from Arcade's layout into the layout the
       nuspecs expect, rather than moving the build output. Do not reinstate this override. -->


  <!-- Positive control for the NU1603 suppression on 'external' above. That suppression is only safe
       while the 16.11.230815 payload is actually staged; if it is missing, packaging silently ships
       a Fakes payload that is absent rather than wrong, and the suppression turns from documented
       into unexamined. Assert its presence rather than trusting it. -->
  <Target Name="VerifyFakesPayloadStaged"
          Condition="'$(MSBuildProjectName)' == 'external'"
          BeforeTargets="Build">
    <PropertyGroup>
      <_FakesPayloadDir>$(RepoRoot)packages\Microsoft.QualityTools.Testing.Fakes.TestRunnerHarness\$(MicrosoftFakesVersion)\contentFiles</_FakesPayloadDir>
    </PropertyGroup>
    <ItemGroup>
      <_FakesPayloadFile Include="$(_FakesPayloadDir)\**\*" />
    </ItemGroup>
    <Error Condition="'@(_FakesPayloadFile)' == ''"
           Text="Fakes payload not staged at $(_FakesPayloadDir). Version $(MicrosoftFakesVersion) is on no feed; restore substitutes a newer one and NU1603 is suppressed for this project on the understanding that packaging reads this path instead. With the path empty that understanding no longer holds - stage the payload from the shipped public package before building." />
    <Message Importance="high" Text="Fakes payload staged: @(_FakesPayloadFile->Count()) files at $(MicrosoftFakesVersion)." />
  </Target>

  <!-- Ported from the 15.9 line's 5e377e743. Same defect, same fix, measured independently here:
       four runtimeconfig.json in the shipped 16.11.0 packages carry no configProperties block, and
       every one this build produced carried

         "configProperties": { "System.Reflection.Metadata.MetadataUpdater.IsSupported": false }

       The modern SDK defaults MetadataUpdaterSupport to false in every non-Debug configuration
       (Microsoft.NET.Sdk.targets:157) and emits it as a runtimeconfig switch whenever the property is
       non-empty (:638). The 2021 SDK had neither. Same family as GenerateDocumentationFile: a modern
       SDK emitting something the old one did not, into an artifact that has to match.

       Removed as an ITEM rather than by clearing the property. The property is defaulted inside the
       SDK targets, so a value set in a props file is overwritten there, and a value set in this file
       depends on import order relative to Microsoft.NET.Sdk.targets. Removing the item in a target
       that runs before the runtimeconfig is generated depends on neither.

       Scoped to the one switch, never to the whole ItemGroup, so a future SDK adding a different
       switch shows up as a new difference instead of being swallowed by a broad removal.

       Found by comparing the packages CI produced against the shipped baseline by content - it was
       invisible to the path-set comparison, which the four files pass. -->
  <Target Name="RemoveMetadataUpdaterRuntimeConfigSwitch"
          BeforeTargets="GenerateBuildRuntimeConfigurationFiles">
    <ItemGroup>
      <RuntimeHostConfigurationOption Remove="System.Reflection.Metadata.MetadataUpdater.IsSupported" />
    </ItemGroup>
  </Target>
  <!-- net451 reference assemblies for the PRODUCT tree.

       This agent image has a v4.5.1 targeting pack directory that EXISTS BUT IS EMPTY - no
       mscorlib.dll - so FrameworkPathOverride points at a real directory containing nothing and every
       net451 project fails with MSB3644 and then CS0518 x N, "predefined type System.Object is not
       defined". A present-but-empty directory is why "is the package available" was the wrong
       question four times on this line.

       WHY IT IS NEEDED HERE AS WELL AS IN test\TestAssets\Directory.Build.props. The test assets are
       deliberately isolated from this file, so the fix cannot be shared with them - sharing it would
       mean importing the root and undoing the isolation. The reverse is also true and is what build
       3064083 measured: after the assets were fixed, MSB3644 fell from 80 to 16, and all 16 remaining
       were PRODUCT projects - Microsoft.TestPlatform.Common, CoreUtilities, ObjectModel, testhost and
       four others - reached as ProjectReferences from `dotnet build TestAssets.sln`, which does not
       go through Arcade's own build entry point. The Arcade Build step compiles them without
       trouble; this path does not.

       Reference the per-TFM SUB-package rather than the meta-package. The meta-package carries no
       build assets of its own; it only declares a dependency on the per-TFM package, and MSBuild does
       not import build\ assets from transitive dependencies - only buildTransitive\ flows, which this
       package does not use. The per-TFM package's .targets is what sets TargetFrameworkRootPath,
       disables FrameworkPathOverride and references mscorlib explicitly.

       Verify by IMPORT, not by restore: obj\<project>.csproj.nuget.g.targets must contain an Import
       naming ...\microsoft.netframework.referenceassemblies.net451\1.0.3\build\. A package can be in
       the restore graph and never imported, which is exactly the state this line measured twice. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' AND '$(TargetFrameworkVersion)' == 'v4.5.1'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net451" Version="1.0.3" PrivateAssets="All" IsImplicitlyDefined="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' AND '$(TargetFrameworkVersion)' == 'v4.5'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net45" Version="1.0.3" PrivateAssets="All" IsImplicitlyDefined="true" />
  </ItemGroup>

</Project>
