<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal, deliberately.

     17.3 takes no darc-managed dependencies on this delivery branch. Product package versions are
     pinned in scripts/build/TestPlatform.Dependencies.props and the Arcade SDK version in
     global.json, which is what the build actually reads.

     The original file on rel/17.3 declared Microsoft.DotNet.Arcade.Sdk 8.0.0-beta.22456.4 while
     global.json pinned 7.0.0-beta.22316.2. Two files describing one toolchain, disagreeing - the
     same defect class as TPVersionPrefix vs VersionPrefix in the version-file rule. Emptying the
     manifest removes the second, non-authoritative spelling rather than updating it to agree, so
     there is nothing left to drift.

     An empty manifest also means no dependency subscription targets this branch.
     Servicing dependency updates are reviewed as separate PRs. -->
<Dependencies>
  <ProductDependencies>
  </ProductDependencies>
  <ToolsetDependencies>
  </ToolsetDependencies>
</Dependencies>
