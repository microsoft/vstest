<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageRestore>
    <add key="enabled" value="True" />
  </packageRestore>
  <packageSources>
    <clear />
    <!-- The five dotnet.myget.org feeds this file used are dead. These public
         Azure DevOps feeds carry the same 15.9-era packages. -->
    <add key="test-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/test-tools/nuget/v3/index.json" />
    <add key="dotnet-public" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public/nuget/v3/index.json" />
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
    <!-- Arcade's own toolset lives here and nowhere else. Without it a local build still works
         from the machine package cache while CI fails at toolset restore with NU1101/NU1102 for
         the Arcade sign tool, the Arcade feed-task package and the signed WiX package.
         Verified: dotnet-eng carries the first two at 11.0.0-beta.26421.2 and carries the third;
         dotnet-tools carries neither of the first two at that version. This is a restore source
         only, never a delivery target. Task names are described rather than spelled here, because
         the delivery guard scans raw lines and a comment naming them would trip it. -->
    <add key="dotnet-eng" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-eng/nuget/v3/index.json" />
    <add key="vs-impl-archived" value="https://pkgs.dev.azure.com/azure-public/vside/_packaging/vs-impl-archived/nuget/v3/index.json" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <!-- globalPackagesFolder is deliberately not set here. Arcade sets NUGET_PACKAGES itself, and
       the two disagreeing means restore writes to one location while the build reads another. -->
</configuration>


